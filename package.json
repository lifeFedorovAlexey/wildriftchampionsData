{
  "name": "wildriftchampions",
  "version": "1.2.3",
  "description": "Wild Rift Champions data",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs start",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:seed": "node scripts/dev.mjs seed",
    "dev:status": "node scripts/dev.mjs status",
    "dev:logs": "node scripts/dev.mjs logs",
    "dev:test": "node --test scripts/dev/*.test.mjs",
    "dev:smoke": "node scripts/dev/smoke.mjs",
    "test": "npm --prefix ui run test",
    "lint": "npm --prefix ui run lint",
    "build": "npm --prefix ui run build",
    "audit:prod": "npm --prefix ui run audit:prod",
    "verify": "npm run lint && npm test && npm run build && npm run audit:prod",
    "sync:data": "node ./scripts/sync-all-data.mjs"
  },
  "overrides": {
    "basic-ftp": "^5.2.1",
    "undici": "^7.24.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2",
    "puppeteer": "^25.15.0",
    "three": "^0.186.1"
  },
  "keywords": [
    "WR",
    "wildRift"
  ],
  "author": "Life",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lifeFedorovAlexey/wildRiftChampions/issues"
  },
  "homepage": "https://github.com/lifeFedorovAlexey/wildRiftChampions#readme",
  "devDependencies": {}
}
